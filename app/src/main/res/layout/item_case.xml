<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    app:cardCornerRadius="@dimen/card_corner"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/card_background"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_m"
        android:gravity="center_vertical">

        <!-- نقطة الخطورة -->
        <View
            android:id="@+id/severityDot"
            android:layout_width="@dimen/severity_dot_size"
            android:layout_height="@dimen/severity_dot_size"
            android:background="@drawable/circle_severity"
            android:layout_marginEnd="@dimen/spacing_m" />

        <!-- النصوص -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="النزيف الحاد"
                xmlns:tools="http://schemas.android.com/tools" />

            <TextView
                android:id="@+id/tvSeverityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/text_small"
                android:textColor="@color/text_secondary"
                tools:text="حرجة"
                xmlns:tools="http://schemas.android.com/tools" />

        </LinearLayout>

        <!-- سهم -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_play"
            android:scaleX="-1"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/button_title" />

    </LinearLayout>

</androidx.cardview.widget.CardView>